# Template konfigurasi PRODUCTION -- bukan file yang beneran dipakai aplikasi.
# Copy isi ini jadi .env di SERVER production (Hostinger), lalu isi semua
# nilai yang masih kosong/placeholder (<...>) dengan nilai asli server itu.
# JANGAN pernah commit .env asli (berisi secret) ke git -- makanya file
# .env.production juga udah di-gitignore, cuma versi *.example ini yang
# boleh ikut git.

APP_NAME=AsetSehat
APP_ENV=production
APP_KEY=
# WAJIB generate KUNCI BARU khusus buat server ini, JANGAN pakai APP_KEY
# yang sama kayak di .env lokal -- jalankan di server: php artisan key:generate
APP_DEBUG=false
# false itu WAJIB di production. Kalau true, siapa aja yang mancing error
# di aplikasi bakal langsung liat stack trace lengkap + path server +
# kadang bocoran config sensitif.
APP_URL=https://<domain-asli-kamu>

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error
# "error" di production -- "debug" (default lokal) kelewat berisik & bisa
# nyimpen data sensitif ke file log yang gak perlu.

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=<nama_database_di_hostinger>
DB_USERNAME=<username_database_di_hostinger>
DB_PASSWORD=<password_kuat_dan_random>
# JANGAN pakai password kosong/lemah kayak di lokal -- ini database beneran
# isinya data pekerja & aset asli.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
# WAJIB true begitu HTTPS aktif -- cookie sesi login cuma boleh dikirim
# lewat koneksi terenkripsi, gak boleh kebawa ke request HTTP biasa.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@<domain-asli-kamu>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
